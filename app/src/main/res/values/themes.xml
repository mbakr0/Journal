<resources>
    <style name="Theme.Newsfeed" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/primaryVariant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="android:colorBackground">@color/white_400</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/white_400</item>
        <item name="colorOnSurfaceVariant">@color/black_400</item>
        <item name="colorSurfaceInverse">@color/black</item>
        <item name="colorOnSurfaceInverse">@color/white</item>
    </style>

    <style name="Journal_TabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Journal_ImageShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="TextColor">
        <item name="android:background">@color/white_200</item>
    </style>

    <style name="My_TextAppearance_Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/autour_one</item>
    </style>
</resources>
